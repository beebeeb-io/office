diff --git a/uui/Library_uui.mk b/uui/Library_uui.mk
index 1bc54ca6e..b2c978ab4 100644
--- a/uui/Library_uui.mk
+++ b/uui/Library_uui.mk
@@ -17,7 +17,20 @@ $(eval $(call gb_Library_set_include,uui,\
 $(eval $(call gb_Library_set_componentfile,uui,uui/util/uui,services))
 
 $(eval $(call gb_Library_use_external,uui,boost_headers))
+# Beebeeb office fork (task 1567): unlike linguistic/Library_lng.mk (which already
+# guards its curl use with `$(if $(ENABLE_CURL),curl)`), this module's curl dependency
+# was unconditional upstream — a real build failure with --disable-curl
+# ("depend(s) on package curl which does not exist"), not a config oversight on our
+# side. Guarded the same way, plus BB_NO_CURL_OAUTH2 tells
+# uui/source/iahndl-authentication.cxx and iahndl-oauth2 to compile out the one
+# curl-calling code path (the CMIS/WebDAV OAuth2 auth-fallback dialog) instead of a
+# new HAVE_FEATURE_CURL config define, since none exists upstream to hook into.
+# See docs/EGRESS.md.
+ifeq ($(ENABLE_CURL),TRUE)
 $(eval $(call gb_Library_use_external,uui,curl))
+else
+$(eval $(call gb_Library_add_defs,uui,-DBB_NO_CURL_OAUTH2))
+endif
 
 $(eval $(call gb_Library_use_custom_headers,uui,\
     officecfg/registry \
@@ -52,7 +65,6 @@ $(eval $(call gb_Library_add_exception_objects,uui,\
 	uui/source/iahndl-filter \
 	uui/source/iahndl-ioexceptions \
 	uui/source/iahndl-locking \
-	uui/source/iahndl-oauth2 \
 	uui/source/iahndl-ssl \
 	uui/source/interactionhandler \
 	uui/source/lockfailed \
@@ -72,4 +84,12 @@ $(eval $(call gb_Library_add_exception_objects,uui,\
 	uui/source/unknownauthdlg \
 ))
 
+# See the BB_NO_CURL_OAUTH2 comment above — this file #includes <curl/curl.h>
+# unconditionally, so it is only buildable when curl itself is enabled.
+ifeq ($(ENABLE_CURL),TRUE)
+$(eval $(call gb_Library_add_exception_objects,uui,\
+	uui/source/iahndl-oauth2 \
+))
+endif
+
 # vim: set noet sw=4 ts=4:
