@@ -0,0 +1,27 @@
+# -*- Mode: makefile-gmake; tab-width: 4; indent-tabs-mode: t -*-
+#
+# This file is part of the LibreOffice project.
+#
+# This Source Code Form is subject to the terms of the Mozilla Public
+# License, v. 2.0. If a copy of the MPL was not distributed with this
+# file, You can obtain one at http://mozilla.org/MPL/2.0/.
+#
+# Beebeeb office fork (task 1567, item 4 -- 2026-09-27): non-Latin fallback +
+# UI font bundle. Sourced by hand (not an upstream LO font module) --
+# see external/more_fonts/README-beebeeb.md for provenance, licenses and the
+# exact upstream commit/build each file came from. Follows the SAME
+# UnpackedTarball+ExternalPackage pattern as font_liberation right next to
+# this file, deliberately -- no new gbuild mechanism, just one more font set
+# in the same already-working pipeline. Strip-components=0 (the 3rd arg,
+# explicit not default): our own tarball is flat (no wrapping directory,
+# unlike most upstream tarballs gbuild's default of 1 assumes) -- found by
+# running the build and reading solenv/gbuild/UnpackedTarball.mk directly,
+# not guessed: the default strip-components=1 silently discarded every file
+# (each filename IS "component 1" with nothing after it to keep).
+#
+
+$(eval $(call gb_UnpackedTarball_UnpackedTarball,font_beebeeb))
+
+$(eval $(call gb_UnpackedTarball_set_tarball,font_beebeeb,$(FONT_BEEBEEB_TARBALL),0))
+
+# vim: set noet sw=4 ts=4:
